---
interface Props { compact?: boolean; light?: boolean; }
const { compact = false, light = false } = Astro.props;
---
<a href="/" class:list={["logo-mark", light && "logo-light"]} aria-label="경동시장 관광정보 가이드 홈">
  <svg viewBox="0 0 56 56" width="44" height="44" aria-hidden="true">
    <path d="M9 20.5 28 8l19 12.5v24.2c0 1.3-1 2.3-2.3 2.3H11.3A2.3 2.3 0 0 1 9 44.7V20.5Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
    <path d="M16 26h24M16 33h24M28 17v25" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
    <circle cx="28" cy="17" r="3.2" fill="#b73b2e"/>
  </svg>
  {!compact && <span><strong>경동시장</strong><small>관광정보 가이드</small></span>}
</a>
<style>
.logo-mark{display:inline-flex;align-items:center;gap:.75rem;color:#17211d}.logo-mark span{display:grid;line-height:1.05}.logo-mark strong{font-family:"Noto Serif KR",serif;font-size:1.06rem;letter-spacing:-.03em}.logo-mark small{font-size:.67rem;letter-spacing:.06em;margin-top:.3rem;opacity:.68}.logo-light{color:#fff}
</style>
