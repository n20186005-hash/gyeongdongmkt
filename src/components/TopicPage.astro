---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOPIC_GROUP_LABELS, getTopic, type TopicContent } from '../data/topics';
import { SITE_NAME } from '../data/site';

interface Props {
  topic: TopicContent;
}
const { topic } = Astro.props;
const home = 'https://gyeongdongmkt.com/';
const selfUrl = new URL(`/${topic.slug}/`, Astro.site ?? home).href;
const groupLabel = TOPIC_GROUP_LABELS[topic.group];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '경동시장 관광정보 가이드', item: home },
    { '@type': 'ListItem', position: 2, name: topic.h1, item: selfUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: topic.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: topic.h1,
  description: topic.metaDescription,
  url: selfUrl,
  inLanguage: 'ko-KR',
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: home },
  about: {
    '@type': 'TouristAttraction',
    name: '경동시장',
    alternateName: ['Gyeongdong Market', 'Kyungdong Market'],
    description: '서울 동대문구의 농산물·약재 등 다양한 품목을 다루는 전통시장 권역.',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '고산자로36길 3',
      addressLocality: '동대문구',
      addressRegion: '서울특별시',
      postalCode: '02571',
      addressCountry: 'KR',
    },
    geo: { '@type': 'GeoCoordinates', latitude: 37.57973, longitude: 127.03854 },
    hasMap: 'https://maps.app.goo.gl/KijUQHBpiftHX1EG6',
  },
  breadcrumb,
};

const related = topic.related.map((slug) => ({ slug, t: getTopic(slug) })).filter((x) => x.t) as { slug: string; t: TopicContent }[];
---
<BaseLayout title={topic.metaTitle} description={topic.metaDescription}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webPage)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="topic-hero">
    <div class="shell">
      <nav class="crumb" aria-label=" breadcrumb">
        <a href="/">홈</a><span aria-hidden="true">/</span><span>{groupLabel}</span><span aria-hidden="true">/</span><span aria-current="page">{topic.h1}</span>
      </nav>
      <p class="topic-kicker">{topic.kicker}</p>
      <h1 class="display topic-h1">{topic.h1}</h1>
      <p class="topic-lead">{topic.lead}</p>
    </div>
  </section>

  <div class="shell topic-body">
    {topic.sections.map((s) => (
      <section class="topic-section">
        <h2>{s.heading}</h2>
        {s.paragraphs?.map((p) => <p>{p}</p>)}
        {s.bullets && (
          <ul>
            {s.bullets.map((b) => <li>{b}</li>)}
          </ul>
        )}
        {s.note && <p class="topic-note">{s.note}</p>}
      </section>
    ))}

    <section class="topic-faq" id="faq">
      <h2 class="display">자주 묻는 질문</h2>
      <div class="topic-faq-list">
        {topic.faqs.map((f) => (
          <details>
            <summary>{f.q}<span>+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    {related.length > 0 && (
      <section class="topic-related">
        <h2 class="display">관련 안내</h2>
        <ul class="related-grid">
          {related.map((r) => (
            <li><a href={`/${r.slug}/`}><span class="rk">{TOPIC_GROUP_LABELS[r.t.group]}</span><strong>{r.t.h1}</strong><small>{r.t.lead}</small></a></li>
          ))}
        </ul>
      </section>
    )}

    <p class="topic-updated">정보 확인일: {topic.updated} · 독립 비공식 안내이며 시장 운영자나 정부기관의 공식 사이트가 아닙니다.</p>
  </div>
</BaseLayout>

<style>
.topic-hero{background:#173e32;color:#fff;padding:clamp(3.5rem,7vw,6rem) 0 clamp(2.5rem,5vw,4rem)}
.crumb{font-size:.82rem;color:#c9d8d0;display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-bottom:1.6rem}
.crumb a{text-decoration:underline;text-underline-offset:3px}
.crumb span[aria-current]{color:#fff;font-weight:700}
.topic-kicker{color:#e2bd72;font-weight:800;letter-spacing:.08em;font-size:.82rem;margin:0 0 .9rem}
.topic-h1{font-size:clamp(2rem,5vw,3.8rem);max-width:20ch;margin:0;line-height:1.15}
.topic-lead{margin-top:1.4rem;max-width:62ch;color:#d6e1da;font-size:clamp(1rem,1.6vw,1.18rem)}
.topic-body{padding-top:clamp(3rem,6vw,5rem);padding-bottom:clamp(3rem,6vw,5rem)}
.topic-section{max-width:74ch;margin-bottom:3rem}
.topic-section h2{font-family:"Iropke Batang","Noto Serif KR",serif;font-size:clamp(1.5rem,3.2vw,2.3rem);margin:0 0 1.2rem;line-height:1.25}
.topic-section p{color:#45504b;margin:.9rem 0}
.topic-section ul{padding-left:1.25rem;color:#45504b}
.topic-section li{margin:.5rem 0}
.topic-note{background:#fffaf0;border:1px solid rgba(23,33,29,.14);padding:1.1rem 1.3rem;border-radius:.4rem;font-size:.92rem;color:#5b655f}
.topic-faq{border-top:1px solid rgba(23,33,29,.18);padding-top:2.5rem;max-width:74ch}
.topic-faq h2{font-size:clamp(1.7rem,3.6vw,2.6rem);margin:0 0 1.5rem}
.topic-faq-list{border-top:1px solid rgba(23,33,29,.2)}
.topic-faq-list details{border-bottom:1px solid rgba(23,33,29,.2);padding:1.1rem 0}
.topic-faq-list summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:1rem;font-weight:800;font-size:1.02rem;min-height:44px;align-items:center}
.topic-faq-list summary::-webkit-details-marker{display:none}
.topic-faq-list summary span{font-size:1.4rem;color:#b73b2e}
.topic-faq-list details[open] summary span{transform:rotate(45deg)}
.topic-faq-list p{color:#56615b;max-width:60rem;padding-right:1rem}
.topic-related{border-top:1px solid rgba(23,33,29,.18);margin-top:3.5rem;padding-top:2.5rem}
.topic-related h2{font-size:clamp(1.7rem,3.6vw,2.6rem);margin:0 0 1.5rem}
.related-grid{list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem}
.related-grid a{display:grid;gap:.35rem;background:#efe6d6;border:1px solid rgba(23,33,29,.12);padding:1.3rem;border-radius:.5rem;min-height:150px}
.related-grid a:hover{border-color:#b73b2e}
.related-grid .rk{font-size:.7rem;font-weight:800;letter-spacing:.06em;color:#b73b2e}
.related-grid strong{font-family:"Noto Serif KR",serif;font-size:1.12rem;line-height:1.3}
.related-grid small{color:#5b655f;font-size:.84rem}
.topic-updated{margin-top:3rem;font-size:.82rem;color:#64706a;border-top:1px solid rgba(23,33,29,.14);padding-top:1.4rem}
@media(max-width:700px){.related-grid{grid-template-columns:1fr}}
</style>
